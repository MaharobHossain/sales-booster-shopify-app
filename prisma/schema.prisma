// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}


model Announcement {
  id          String   @id @default(cuid())
  shop        String
  message     String
  link        String?
  bgColor     String   @default("#202223")
  textColor   String   @default("#ffffff")
  fontSize    Int      @default(14)
  textAlign   String   @default("center")
  isActive    Boolean  @default(false)
  dismissible Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Recommendation {
  id                      String   @id @default(cuid())
  shop                    String
  heading                 String   @default("You might also like")
  headingColor            String   @default("#202223")
  headingFontSizeDesktop  Int      @default(24)
  headingFontSizeMobile   Int      @default(18)
  backgroundColor         String   @default("#ffffff")
  productLimit            Int      @default(4)
  columnsDesktop          Int      @default(4)
  columnsMobile           Int      @default(2)
  cardStyle               String   @default("style1")
  isActive                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CountdownTimer {
  id                     String    @id @default(cuid())
  shop                   String
  template               String    @default("minimal")
  mode                   String    @default("fixed")
  endDateTime            DateTime?
  dailyEndTime           String    @default("23:59")
  title                  String    @default("Limited Time Offer")
  caption                String    @default("")
  buttonText             String    @default("")
  buttonLink             String    @default("")
  bgColor                String    @default("#202223")
  textColor              String    @default("#ffffff")
  accentColor            String    @default("#008060")
  titleFontSizeDesktop   Int       @default(22)
  titleFontSizeMobile    Int       @default(16)
  numberFontSizeDesktop  Int       @default(36)
  numberFontSizeMobile   Int       @default(24)
  isActive               Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model SocialProof {
  id              String   @id @default(cuid())
  shop            String
  template        String   @default("simple")
  mode            String   @default("demo")
  position        String   @default("bottom-left")
  pageTargeting   String   @default("all")
  displayDuration Int      @default(5000)
  intervalBetween Int      @default(8000)
  firstDelayMs    Int      @default(3000)
  randomizeOrder  Boolean  @default(true)
  showTimeAgo     Boolean  @default(true)
  demoItems       String   @default("[]")
  bgColor         String   @default("#ffffff")
  gradientStart   String   @default("#fff9db")
  gradientEnd     String   @default("#ffe3ec")
  textColor       String   @default("#202223")
  accentColor     String   @default("#008060")
  brandLine       String   @default("")
  fontSizeDesktop Int      @default(14)
  fontSizeMobile  Int      @default(12)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  shop      String
  feature   String
  eventType String
  createdAt DateTime @default(now())

  @@index([shop, feature, eventType])
}