{% assign announcement = shop.metafields.sales_booster.announcement.value %}

{% if announcement and announcement.isActive %}
  <div
    class="sb-announcement-bar"
    style="background: {{ announcement.bgColor }}; color: {{ announcement.textColor }}; font-size: {{ announcement.fontSize }}px;"
  >
    {% if announcement.link != blank %}
      <a href="{{ announcement.link }}" style="color: inherit; text-decoration: none;">
        {{ announcement.message }}
      </a>
    {% else %}
      {{ announcement.message }}
    {% endif %}
  </div>
{% endif %}

<style>
  .sb-announcement-bar {
    text-align: center;
    padding: 10px 16px;
    width: 100%;
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "target": "section",
  "settings": []
}
{% endschema %}