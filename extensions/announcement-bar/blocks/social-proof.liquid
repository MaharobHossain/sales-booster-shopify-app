{% assign settings = shop.metafields.sales_booster.social_proof.value %}

{% if settings != blank and settings.isActive %}
  {% assign show_here = false %}
  {% assign target_pages = settings.pageTargeting | default: "all" %}

  {% if target_pages == "all" %}
    {% assign show_here = true %}
  {% elsif target_pages == "home" and template == "index" %}
    {% assign show_here = true %}
  {% elsif target_pages == "product" and template contains "product" %}
    {% assign show_here = true %}
  {% elsif target_pages == "collection" and template contains "collection" %}
    {% assign show_here = true %}
  {% endif %}

  {% if show_here %}
    {% if settings.mode == 'real' or settings.demoItems.size > 0 %}
      <div
        id="sb-social-proof-{{ block.id }}"
        class="sb-sp-container sb-sp-{{ settings.position | default: 'bottom-left' }}"
        data-template="{{ settings.template | default: 'simple' }}"
        data-mode="{{ settings.mode | default: 'demo' }}"
        data-display-duration="{{ settings.displayDuration | default: 5000 }}"
        data-interval="{{ settings.intervalBetween | default: 8000 }}"
        data-first-delay="{{ settings.firstDelayMs | default: 3000 }}"
        data-randomize="{{ settings.randomizeOrder | default: true }}"
        data-show-time-ago="{{ settings.showTimeAgo | default: true }}"
        data-items="{{ settings.demoItems | json | escape }}"
        data-brand-line="{{ settings.brandLine | escape }}"
        data-real-url="/apps/proxy/social-proof?shop={{ shop.permanent_domain }}"
        style="
          --sb-sp-bg: {{ settings.bgColor | default: '#ffffff' }};
          --sb-sp-gradient-start: {{ settings.gradientStart | default: '#fff9db' }};
          --sb-sp-gradient-end: {{ settings.gradientEnd | default: '#ffe3ec' }};
          --sb-sp-text: {{ settings.textColor | default: '#202223' }};
          --sb-sp-accent: {{ settings.accentColor | default: '#008060' }};
          --sb-sp-font-mobile: {{ settings.fontSizeMobile | default: 12 }}px;
          --sb-sp-font-desktop: {{ settings.fontSizeDesktop | default: 14 }}px;
        "
      ></div>

    <style>
      .sb-sp-container {
        font-size: var(--sb-sp-font-mobile);
        pointer-events: none;
        position: fixed;
        z-index: 999999;
      }

      @media screen and (min-width: 750px) {
        .sb-sp-container {
          font-size: var(--sb-sp-font-desktop);
        }
      }

      .sb-sp-bottom-left { bottom: 20px; left: 20px; }
      .sb-sp-bottom-right { bottom: 20px; right: 20px; }
      .sb-sp-top-left { top: 20px; left: 20px; }
      .sb-sp-top-right { top: 20px; right: 20px; }

      .sb-sp-card {
        opacity: 0;
        pointer-events: auto;
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      .sb-sp-bottom-left .sb-sp-card,
      .sb-sp-bottom-right .sb-sp-card {
        transform: translateY(20px);
      }
      .sb-sp-top-left .sb-sp-card,
      .sb-sp-top-right .sb-sp-card {
        transform: translateY(-20px);
      }
      .sb-sp-card.sb-sp-visible {
        opacity: 1;
        transform: translateY(0);
      }

      .sb-sp-simple {
        align-items: center;
        background: var(--sb-sp-bg);
        border-radius: 10px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        color: var(--sb-sp-text);
        display: flex;
        gap: 10px;
        max-width: 320px;
        padding: 12px 14px;
      }

      .sb-sp-simple .sb-sp-icon {
        flex-shrink: 0;
        font-size: 20px;
      }

      .sb-sp-simple .sb-sp-message {
        line-height: 1.4;
      }

      .sb-sp-simple .sb-sp-time {
        color: var(--sb-sp-accent);
        font-size: 11px;
        margin-top: 2px;
      }

      .sb-sp-gradient {
        background: linear-gradient(
          135deg,
          var(--sb-sp-gradient-start),
          var(--sb-sp-gradient-end)
        );
        border-radius: 16px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        color: var(--sb-sp-text);
        max-width: 340px;
        padding: 16px;
        position: relative;
      }

      .sb-sp-gradient-inner {
        align-items: center;
        display: flex;
        gap: 12px;
      }

      .sb-sp-avatar {
        border: 2px solid #fff;
        border-radius: 50%;
        flex-shrink: 0;
        height: 40px;
        object-fit: cover;
        width: 40px;
      }

      .sb-sp-avatar-fallback {
        align-items: center;
        background: #a2d2ff;
        border: 2px solid #fff;
        border-radius: 50%;
        color: #fff;
        display: flex;
        flex-shrink: 0;
        font-size: 16px;
        font-weight: 700;
        height: 40px;
        justify-content: center;
        width: 40px;
      }

      .sb-sp-gradient-message {
        font-weight: 700;
        line-height: 1.4;
      }

      .sb-sp-brand-line {
        font-size: 10px;
        margin-top: 4px;
        opacity: 0.6;
      }

      .sb-sp-close {
        background: none;
        border: none;
        color: var(--sb-sp-text);
        cursor: pointer;
        font-size: 16px;
        opacity: 0.5;
        padding: 0;
      }

      .sb-sp-gradient .sb-sp-close {
        position: absolute;
        right: 10px;
        top: 10px;
      }
    </style>

    <script>
      (function () {
        var container = document.getElementById(
          "sb-social-proof-{{ block.id }}"
        );
        if (!container) return;

        var items = [];
        try {
          items = JSON.parse(container.dataset.items || "[]");
        } catch (e) {
          items = [];
        }

        var template = container.dataset.template;
        var brandLine = container.dataset.brandLine || "";
        var displayDuration = parseInt(container.dataset.displayDuration, 10);
        var interval = parseInt(container.dataset.interval, 10);
        var firstDelay = parseInt(container.dataset.firstDelay, 10);
        var randomize = container.dataset.randomize === "true";
        var showTimeAgo = container.dataset.showTimeAgo === "true";
        var mode = container.dataset.mode || "demo";

        function loadRealItems() {
          if (!container.dataset.realUrl) return Promise.resolve([]);

          return fetch(container.dataset.realUrl)
            .then(function (response) {
              if (!response.ok) return [];
              return response.json();
            })
            .then(function (payload) {
              return Array.isArray(payload && payload.items) ? payload.items : [];
            })
            .catch(function () {
              return [];
            });
        }

        if (mode === "real") {
          loadRealItems().then(function (realItems) {
            items = realItems;
            if (items.length === 0) return;
            startQueue();
          });
          return;
        }

        if (items.length === 0) return;

        startQueue();

        function startQueue() {

        var typeIcons = {
          purchase: "🛒",
          viewer: "👀",
          lowstock: "⚠️",
          custom: "🔔",
        };

        function buildMessage(item) {
          if (item.type === "purchase") {
            return (
              (item.name || "Someone") +
              " from " +
              (item.location || "somewhere") +
              " just bought " +
              (item.product || "a product")
            );
          }
          if (item.type === "viewer") {
            return (
              (item.viewerCount || "12") + " people are viewing this page"
            );
          }
          if (item.type === "lowstock") {
            return (
              "Only " +
              (item.stockCount || "3") +
              " left of " +
              (item.product || "this item") +
              "!"
            );
          }
          return item.customMessage || "";
        }

        function escapeHtml(str) {
          var div = document.createElement("div");
          div.textContent = str || "";
          return div.innerHTML;
        }

        function shuffle(arr) {
          var a = arr.slice();
          for (var i = a.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = a[i];
            a[i] = a[j];
            a[j] = tmp;
          }
          return a;
        }

        function buildSimpleCard(item) {
          var card = document.createElement("div");
          card.className = "sb-sp-card sb-sp-simple";
          card.innerHTML =
            '<span class="sb-sp-icon">' +
            (typeIcons[item.type] || "🔔") +
            "</span>" +
            '<div class="sb-sp-body">' +
            '<div class="sb-sp-message">' +
            escapeHtml(buildMessage(item)) +
            "</div>" +
            (showTimeAgo
              ? '<div class="sb-sp-time">' +
                (Math.floor(Math.random() * 10) + 1) +
                " minutes ago</div>"
              : "") +
            "</div>" +
            '<button class="sb-sp-close" aria-label="Close">&times;</button>';
          return card;
        }

        function buildGradientCard(item) {
          var card = document.createElement("div");
          card.className = "sb-sp-card sb-sp-gradient";

          var avatarHtml = "";
          if (item.avatarUrl) {
            avatarHtml =
              '<img class="sb-sp-avatar" src="' +
              escapeHtml(item.avatarUrl) +
              '" alt="">';
          } else {
            var initial = ((item.name || "S").charAt(0) || "S").toUpperCase();
            avatarHtml =
              '<div class="sb-sp-avatar-fallback">' + initial + "</div>";
          }

          card.innerHTML =
            '<button class="sb-sp-close" aria-label="Close">&times;</button>' +
            '<div class="sb-sp-gradient-inner">' +
            avatarHtml +
            "<div>" +
            '<div class="sb-sp-gradient-message">' +
            escapeHtml(buildMessage(item)) +
            "</div>" +
            (brandLine
              ? '<div class="sb-sp-brand-line">' +
                escapeHtml(brandLine) +
                "</div>"
              : "") +
            "</div>" +
            "</div>";
          return card;
        }

        var queue = randomize ? shuffle(items) : items.slice();
        var queueIndex = 0;

        function showNext() {
          if (queueIndex >= queue.length) {
            queueIndex = 0;
            if (randomize) queue = shuffle(items);
          }

          var item = queue[queueIndex];
          queueIndex++;

          var card =
            template === "gradientAvatars"
              ? buildGradientCard(item)
              : buildSimpleCard(item);

          container.innerHTML = "";
          container.appendChild(card);

          requestAnimationFrame(function () {
            card.classList.add("sb-sp-visible");
          });

          var hideTimeout = setTimeout(function () {
            card.classList.remove("sb-sp-visible");
          }, displayDuration);

          var closeBtn = card.querySelector(".sb-sp-close");
          if (closeBtn) {
            closeBtn.addEventListener("click", function () {
              clearTimeout(hideTimeout);
              card.classList.remove("sb-sp-visible");
            });
          }

          setTimeout(showNext, interval);
        }

          setTimeout(showNext, firstDelay);
        }
      })();
    </script>
    {% endif %}
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Social Proof",
  "target": "section"
}
{% endschema %}